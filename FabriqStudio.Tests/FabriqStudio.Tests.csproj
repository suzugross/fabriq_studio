<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FabriqStudio の自動テスト（xunit）。
    実行: リポジトリ直下で  dotnet test FabriqStudio.Tests
    publish には含まれない（CLAUDE.md の publish は FabriqStudio.csproj を直接指定する）。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FabriqStudio.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FabriqStudio\FabriqStudio.csproj" />
  </ItemGroup>

</Project>
