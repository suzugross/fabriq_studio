<Window x:Class="FabriqStudio.Views.GpoPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FabriqStudio.Views"
        Title="{Binding Title}"
        Width="1120" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                <views:GpoBrowserControl x:Name="Browser" DataContext="{Binding Browser}" />
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <views:GpoPolicyConfigControl DataContext="{Binding Config}" />
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="キャンセル" Command="{Binding CancelCommand}" IsCancel="True"
                    Padding="16,6" FontSize="12" Margin="8,0,0,0" Cursor="Hand" />
            <Button DockPanel.Dock="Right" Content="{Binding OkLabel}" Command="{Binding OkCommand}"
                    Padding="22,6" FontSize="12" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock DockPanel.Dock="Left" Text="左でポリシーを検索して選び、右で状態とオプションを決めてください（ダブルクリックでも追加できます）。"
                       FontSize="11" Foreground="#666666" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
