<Window x:Class="FabriqStudio.Views.AppAssocEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="既定のアプリの関連付け（AppAssoc.xml）"
        Width="1060" Height="720" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding"  Value="10,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin"   Value="0,0,6,0" />
            <Setter Property="Cursor"   Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 読み込み元 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="保存先:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding TargetRelLabel}" FontSize="11.5" FontFamily="Consolas" Foreground="#333333" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SourceInfo}" FontSize="11" Foreground="#3050CC" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="読み込み元:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="ワークスペースの XML" Command="{Binding LoadWorkspaceCommand}" Style="{StaticResource ToolButton}" ToolTip="default_app_config/xml/AppAssoc.xml を読み直します" />
                    <Button Content="同梱のひな形" Command="{Binding LoadBaseCommand}" Style="{StaticResource ToolButton}" ToolTip="Windows 11 24H2 の既定 + Chrome の見本" />
                    <Button Content="XML を開く..." Command="{Binding OpenFileCommand}" Style="{StaticResource ToolButton}" ToolTip="マスタ PC で Export App Associations したファイルなど" />
                    <Button Content="この PC からエクスポート（要管理者権限）" Command="{Binding ExportFromPcCommand}" Style="{StaticResource ToolButton}"
                            ToolTip="Dism /Online /Export-DefaultAppAssociations を管理者権限で実行して読み込みます" />
                    <TextBlock Text="処理中..." FontSize="11" Foreground="#888888" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- カテゴリ一括 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="主要な種類をまとめて差し替え（ProgId が分かる識別子だけ変えます）" FontSize="11" Foreground="#666666" />
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" MinWidth="64" Foreground="#333333" />
                                    <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp, Mode=TwoWay}" Width="200" FontSize="11.5" Margin="6,0" />
                                    <Button Content="適用" Command="{Binding ApplyCommand}" Padding="8,2" FontSize="11" Cursor="Hand" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- フィルタ -->
        <DockPanel Grid.Row="2" Margin="0,8,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="絞り込み:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="4,3" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"
                     ToolTip="拡張子・アプリ名・ProgId で絞り込み" />
        </DockPanel>

        <!-- 一覧 -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" FontSize="11.5"
                  Background="White" BorderBrush="#DDDDDD" BorderThickness="1" HorizontalGridLinesBrush="#EEEEEE"
                  SelectionMode="Single" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="拡張子 / プロトコル" Binding="{Binding Identifier}" IsReadOnly="True" Width="150" FontFamily="Consolas" />
                <DataGridTemplateColumn Header="アプリ（候補から選ぶか入力）" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" ItemsSource="{Binding Candidates}"
                                      SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                      Text="{Binding ApplicationName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      IsTextSearchEnabled="False" FontSize="11.5" BorderThickness="0" Background="Transparent">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="11.5" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#777777" FontFamily="Consolas" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ProgId" Binding="{Binding ProgId, UpdateSourceTrigger=PropertyChanged}" Width="*" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 下部 -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="キャンセル" Command="{Binding CancelCommand}" IsCancel="True" Padding="16,6" FontSize="12" Margin="8,0,0,0" Cursor="Hand" />
            <Button DockPanel.Dock="Right" Content="保存して閉じる" Command="{Binding SaveCommand}" Padding="18,6" FontSize="12"
                    Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#107C10" TextWrapping="Wrap"
                           Visibility="{Binding Status, Converter={StaticResource NullToCollapsedConverter}}" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C04040" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                <TextBlock Text="行は消さないでください（欠けた種類は初回サインイン時に「既定のアプリがリセットされました」通知が出ます）。保存すると default_app_config/xml/AppAssoc.xml に書き、生成時に sysprep_config/source にもコピーします。"
                           FontSize="10.5" Foreground="#777777" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
