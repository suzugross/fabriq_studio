<UserControl x:Class="FabriqStudio.Views.MasterParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="clr-namespace:FabriqStudio.ViewModels.Master"
             xmlns:converters="clr-namespace:FabriqStudio.Converters">

    <UserControl.Resources>
        <converters:MasterKindToBrushConverter x:Key="KindToBrush" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2D2D30" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="White" />
            <Setter Property="BorderBrush"     Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="4" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="Margin"          Value="0,0,0,10" />
        </Style>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin"     Value="0,0,0,2" />
        </Style>
        <Style x:Key="ItemLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping"      Value="Wrap" />
        </Style>
        <Style x:Key="EditableTextBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Padding"         Value="4,3" />
            <Setter Property="Background"      Value="#F8F8F8" />
            <Setter Property="BorderBrush"     Value="#CCCCCC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background"  Value="White" />
                    <Setter Property="BorderBrush" Value="#007ACC" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditableCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding"  Value="6,3" />
            <Setter Property="MinWidth" Value="200" />
        </Style>

        <!-- 落ち先バッジ -->
        <DataTemplate x:Key="KindBadge">
            <Border Background="{Binding Kind, Converter={StaticResource KindToBrush}}"
                    CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="{Binding Target}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Bold"
                               Foreground="{Binding Kind, Converter={StaticResource KindToBrush}, ConverterParameter=fg}" />
                    <TextBlock Text="{Binding Target}" FontSize="10" Margin="6,0,0,0"
                               Foreground="{Binding Kind, Converter={StaticResource KindToBrush}, ConverterParameter=fg}"
                               MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 行レイアウト: ラベル | 入力 | バッジ（行間は点線で区切る） -->
        <Style x:Key="ItemRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <!-- ══ 質問 DataTemplate（VM の型で自動選択） ══ -->

        <DataTemplate DataType="{x:Type mvm:InfoItemViewModel}">
            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#777777" FontStyle="Italic"
                       TextWrapping="Wrap" Margin="0,2,0,6"
                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:BoolItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" FontSize="12" Foreground="#333333"
                          ToolTip="{Binding Help}"
                          IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </CheckBox>
                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:ChoiceItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource ItemLabel}" ToolTip="{Binding Help}" />
                <ComboBox Grid.Column="1" Style="{StaticResource EditableCombo}"
                          ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          DisplayMemberPath="Label" HorizontalAlignment="Left"
                          IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:TextItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource ItemLabel}" ToolTip="{Binding Help}" />
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" FontSize="11" Foreground="#666666"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding Placeholder}"
                             IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource EditableTextBox}">
                                <Setter Property="MaxWidth" Value="460" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="MinWidth" Value="260" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                        <Setter Property="AcceptsReturn" Value="True" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="MinHeight" Value="64" />
                                        <Setter Property="MaxWidth" Value="9999" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:NumberItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource ItemLabel}" ToolTip="{Binding Help}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" HorizontalContentAlignment="Right"
                             IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource EditableTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="#C04040" />
                                        <Setter Property="Background"  Value="#FFF3F3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#666666"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:FileItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource ItemLabel}" VerticalAlignment="Top" Margin="0,6,0,0" ToolTip="{Binding Help}" />
                <Border Grid.Column="1" Padding="10,7" CornerRadius="4" HorizontalAlignment="Stretch"
                        Background="#EEF5FF" BorderBrush="#8FB4F5" BorderThickness="1.5"
                        AllowDrop="True" DragEnter="OnAssetDragOver" DragOver="OnAssetDragOver" Drop="OnAssetDrop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFile}" Value="True">
                                    <Setter Property="Background" Value="#E6F4EC" />
                                    <Setter Property="BorderBrush" Value="#6FC79A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearCommand}" ToolTip="参照を外す（ファイルは残る）"
                                FontSize="11" Padding="6,0" Margin="8,0,0,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel>
                            <TextBlock FontSize="11.5" Foreground="#1E4A99" FontWeight="SemiBold" TextWrapping="Wrap">
                                <Run Text="⤓ " /><Run Text="{Binding DropHint, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="#444444" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding DropMessage}" FontSize="10.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding DropMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}" VerticalAlignment="Top"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:ActionItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource ItemLabel}" VerticalAlignment="Top" Margin="0,5,0,0" ToolTip="{Binding Help}" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding RunCommand}" Padding="12,4" FontSize="12" Cursor="Hand"
                                Background="#107C10" Foreground="White" BorderThickness="0" ToolTip="{Binding Help}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="{Binding ButtonLabel}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="{Binding RunningLabel}" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="#666666" VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#333333" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Status, Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>
                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}" VerticalAlignment="Top"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:MultiItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource ItemLabel}"
                           VerticalAlignment="Top" Margin="0,4,0,0" ToolTip="{Binding Help}" />
                <StackPanel Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          ToolTip="{Binding Value}" FontSize="11.5" Margin="0,2,14,2"
                                          IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 自由追加 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding AllowFree, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding FreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260" Style="{StaticResource EditableTextBox}" ToolTip="リストに無い値を追加"
                                 IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="＋ 追加" Command="{Binding AddFreeCommand}" Padding="8,2" FontSize="11" Margin="6,0,0,0" Cursor="Hand" />
                        <ItemsControl ItemsSource="{Binding FreeEntries}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF0FF" CornerRadius="3" Padding="6,1" Margin="0,0,6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#3050CC" VerticalAlignment="Center" />
                                            <Button Content="×" FontSize="10" Padding="4,0" Margin="4,0,0,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveFreeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}" VerticalAlignment="Top"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mvm:TableItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Style="{StaticResource ItemLabel}" ToolTip="{Binding Help}" />
                    <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button DockPanel.Dock="Right" Content="🗑 行削除" Command="{Binding DeleteRowCommand}"
                            Padding="8,2" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Content="＋ 行追加" Command="{Binding AddRowCommand}"
                            Padding="8,2" FontSize="11" Margin="0,0,6,0" Cursor="Hand"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DockPanel>
                <!-- 資材のドロップ枠（テンプレートに drop 設定がある表だけ） -->
                <Border Grid.Row="1" Margin="0,0,0,6" Padding="10,7" CornerRadius="4"
                        Background="#EEF5FF" BorderBrush="#8FB4F5" BorderThickness="1.5"
                        AllowDrop="True" DragEnter="OnAssetDragOver" DragOver="OnAssetDragOver" Drop="OnAssetDrop"
                        Visibility="{Binding HasDrop, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="11.5" Foreground="#1E4A99" FontWeight="SemiBold" TextWrapping="Wrap">
                            <Run Text="⤓ " /><Run Text="{Binding DropHint, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding DropMessage}" FontSize="10.5" Foreground="#444444" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding DropMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    </StackPanel>
                </Border>
                <DataGrid Grid.Row="2"
                          AllowDrop="True" DragEnter="OnAssetDragOver" DragOver="OnAssetDragOver" Drop="OnAssetDrop"
                          ItemsSource="{Binding Table.DefaultView}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="True"
                          AutoGeneratingColumn="OnTableAutoGeneratingColumn"
                          IsReadOnly="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" FontSize="11.5" MaxHeight="260"
                          Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                          HorizontalGridLinesBrush="#EEEEEE" />
            </Grid>
        </DataTemplate>

        <!-- GPO 辞書から選んだポリシーの一覧（追加／編集はダイアログ） -->
        <DataTemplate DataType="{x:Type mvm:GpoItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Style="{StaticResource ItemLabel}" ToolTip="{Binding Help}" />
                    <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button DockPanel.Dock="Right" Content="🗑 削除" Command="{Binding RemoveCommand}"
                            Padding="8,2" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Content="✏ 編集" Command="{Binding EditCommand}"
                            Padding="8,2" FontSize="11" Margin="0,0,6,0" Cursor="Hand" ToolTip="状態やオプションを変える（行のダブルクリックでも開きます）"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Content="🔍 辞書から追加" Command="{Binding AddCommand}"
                            Padding="10,2" FontSize="11" Margin="0,0,6,0" Cursor="Hand"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CatalogState}" FontSize="10.5" Foreground="#9A6700" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding CatalogState, Converter={StaticResource NullToCollapsedConverter}}" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="10.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,4" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                         MaxHeight="340" BorderBrush="#DDDDDD" BorderThickness="1" Background="White"
                         HorizontalContentAlignment="Stretch" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnGpoListDoubleClick"
                         Visibility="{Binding HasPolicies, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#F0F0F0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Margin="0,1,8,0" VerticalAlignment="Top" MinWidth="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6E6E6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateLabel}" Value="有効">
                                                    <Setter Property="Background" Value="#DDF3E4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateLabel}" Value="無効">
                                                    <Setter Property="Background" Value="#FBE3E3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#222222" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#C04040" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CategoryPath}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryPath}" />
                                    <TextBlock Text="{Binding ElementSummary}" FontSize="10.5" Foreground="#3050CC" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Visibility="{Binding ElementSummary, Converter={StaticResource NullToCollapsedConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                    <Border Background="#EEF3FA" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ScopeLabel}" FontSize="9.5" Foreground="#2B4C7E" />
                                    </Border>
                                    <TextBlock Text="{Binding RowCountText}" FontSize="10" Foreground="#666666" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <!-- レジストリ辞書から選んだ設定の一覧（追加はダイアログ、値は行ごとに編集） -->
        <DataTemplate DataType="{x:Type mvm:RegistryItemViewModel}">
            <Grid Style="{StaticResource ItemRowGrid}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Style="{StaticResource ItemLabel}" ToolTip="{Binding Help}" />
                    <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}"
                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button DockPanel.Dock="Right" Content="🗑 削除" Command="{Binding RemoveCommand}"
                            Padding="8,2" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Content="🔍 辞書から追加" Command="{Binding AddCommand}"
                            Padding="10,2" FontSize="11" Margin="0,0,6,0" Cursor="Hand"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="10.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,4" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         MaxHeight="340" BorderBrush="#DDDDDD" BorderThickness="1" Background="White"
                         HorizontalContentAlignment="Stretch" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#F0F0F0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Margin="0,1,8,0" VerticalAlignment="Top" MinWidth="44">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF3FA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Background" Value="#FBE3E3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#2B4C7E" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Hive}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Text" Value="無し" />
                                                        <Setter Property="Foreground" Value="#C04040" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#222222" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#C04040" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding KeyText}" FontSize="10" Foreground="#777777" TextWrapping="Wrap" ToolTip="{Binding KeyPath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBox}" Width="150"
                                             ToolTip="{Binding ValueHint}"
                                             IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Content="↺" Command="{Binding ResetValueCommand}" ToolTip="辞書の値に戻す"
                                            FontSize="11" Padding="6,0" Margin="4,0,0,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Visibility="{Binding IsValueChanged, Converter={StaticResource BoolToVisibilityConverter}}"
                                            IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <!-- 章の中のジャンル（カード） -->
        <DataTemplate DataType="{x:Type mvm:MasterBlockViewModel}">
            <Border Background="White" BorderBrush="#D9E1EC" BorderThickness="1" CornerRadius="5" Margin="0,0,0,12">
                <StackPanel>
                    <Border Background="#EEF3FA" CornerRadius="5,5,0,0" Padding="12,6" BorderBrush="#D9E1EC" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="#007ACC" CornerRadius="2" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E4A99" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="14,8,14,8">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,2" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 章（1 ページ） -->
        <DataTemplate DataType="{x:Type mvm:MasterSectionViewModel}">
            <StackPanel>
                <Border Background="#2B4C7E" CornerRadius="5" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="#FFFFFF" CornerRadius="3" Padding="8,2" VerticalAlignment="Center" Opacity="0.9"
                                    Visibility="{Binding HasGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontSize="10.5" Foreground="#2B4C7E">
                                    <Run Text="Group:" /><Run Text="{Binding Group, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border DockPanel.Dock="Right" Background="#FFD37A" CornerRadius="9" Padding="8,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasModified, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontSize="10.5" Foreground="#5A3E00" FontWeight="SemiBold">
                                    <Run Text="変更 " /><Run Text="{Binding ModifiedCount, Mode=OneWay}" /><Run Text=" 件" />
                                </TextBlock>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#DCE6F5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Blocks}" />
            </StackPanel>
        </DataTemplate>

        <!-- プレビュー行 -->
        <DataTemplate x:Key="PreviewRowTemplate">
            <Border Background="{Binding ScriptPath, Converter={StaticResource SpecialMarkerToBackgroundConverter}}"
                    Padding="6,1" Margin="0,0,0,1" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Order}" FontSize="10.5" Foreground="#888888" FontFamily="Consolas" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ScriptPath}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemCommand}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Group}" FontSize="10" Foreground="#3050CC" Margin="6,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダーバー ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="🧭 マスタ設計" FontSize="18" FontWeight="Bold" Foreground="#2D2D30" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="ヒアリングの回答から、案件用のマスタキッティングプロファイルとモジュール CSV 行を生成します"
                               FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="14,0,0,0" />

                    <!-- 右: ロック / 保存 / プレビュー -->
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsLocked}" Padding="10,4" FontSize="12" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="🔒 ロック中（読み取り専用）" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content" Value="✏️ 編集中" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button DockPanel.Dock="Right" Content="🧭 プレビュー／生成" Command="{Binding PreviewCommand}"
                            Padding="14,5" FontSize="12" Background="#107C10" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="計画を確認してから書き込みます（回答は先に保存されます）" />
                    <Button DockPanel.Dock="Right" Content="💾 回答を保存" Command="{Binding SaveCommand}"
                            Padding="14,5" FontSize="12" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#107C10" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    <TextBlock DockPanel.Dock="Right" Text="読み込み中..." Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock DockPanel.Dock="Right" Text="● 未保存の変更があります" Foreground="OrangeRed" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DockPanel>

                <!-- 案件メタ -->
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="保存済みマスタ" Style="{StaticResource HeaderLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding ExistingMasters}" SelectedItem="{Binding SelectedExistingMaster, Mode=TwoWay}"
                                      Width="200" FontSize="12" Padding="6,3" ToolTip="profiles/*.master.json" />
                            <Button Content="＋ 新規" Command="{Binding NewMasterCommand}" Padding="10,3" FontSize="11" Margin="6,0,0,0" Cursor="Hand" />
                            <Button Content="🔄" Command="{Binding ReloadCommand}" Padding="8,3" FontSize="11" Margin="4,0,0,0" Cursor="Hand" ToolTip="テンプレートとワークスペースを再読込" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="マスタ名（= Segment / プロファイル名、半角英数字・_・-）" Style="{StaticResource HeaderLabel}" />
                        <TextBox Text="{Binding MasterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                 IsEnabled="{Binding IsEditable}" FontFamily="Consolas">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasterNameValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#C04040" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="案件名" Style="{StaticResource HeaderLabel}" />
                        <TextBox Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                 Style="{StaticResource EditableTextBox}" IsEnabled="{Binding IsEditable}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="版" Style="{StaticResource HeaderLabel}" />
                        <TextBox Text="{Binding VersionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 Style="{StaticResource EditableTextBox}" IsEnabled="{Binding IsEditable}" HorizontalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="担当" Style="{StaticResource HeaderLabel}" />
                        <TextBox Text="{Binding Worker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                 Style="{StaticResource EditableTextBox}" IsEnabled="{Binding IsEditable}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="メモ" Style="{StaticResource HeaderLabel}" />
                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                 Style="{StaticResource EditableTextBox}" IsEnabled="{Binding IsEditable}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastGeneratedText}" FontSize="11" Foreground="#666666" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               Visibility="{Binding LastGeneratedText, Converter={StaticResource NullToCollapsedConverter}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== 本体: 章レール | 章ページ | プレビュー ===== -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 左: 章レール -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" Margin="0" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="章（ヒアリングシートの章立て）" Style="{StaticResource SectionHeaderStyle}" FontSize="11.5" Margin="8,4,0,6" />
                    <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EEF3FA" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2B4C7E" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#FFD37A" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasModified, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ModifiedCount}" FontSize="10" Foreground="#5A3E00" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 中央: 選択中の章だけを表示 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="FormScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding SelectedSection}" DataContextChanged="OnSectionContentChanged" />
                </ScrollViewer>
                <!-- 前後の章へ -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="← 前の章" Command="{Binding PrevSectionCommand}" Padding="12,4" FontSize="12" Cursor="Hand" />
                        <Button DockPanel.Dock="Right" Content="次の章 →" Command="{Binding NextSectionCommand}" Padding="12,4" FontSize="12" Cursor="Hand" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SectionPositionText}" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,14,0" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右: 生成プレビュー -->
            <Border Grid.Column="4" Style="{StaticResource SectionBorderStyle}" Margin="0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="生成プレビュー" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewSummary}" FontSize="10.5" Foreground="#666666" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Top" Text="⛔ エラーがあるため生成できません（下の警告を確認）" FontSize="11" Foreground="#C04040" Margin="0,0,0,6" TextWrapping="Wrap"
                               Visibility="{Binding HasPlanErrors, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,3">
                                <Run Text="profiles/" /><Run Text="{Binding MasterName, Mode=OneWay}" /><Run Text=".csv" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PreviewRows}" ItemTemplate="{StaticResource PreviewRowTemplate}" />

                            <StackPanel Visibility="{Binding HasSysprepPreview, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,10,0,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,3">
                                    <Run Text="profiles/" /><Run Text="{Binding MasterName, Mode=OneWay}" /><Run Text="_sysprep.csv" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding PreviewSysprepRows}" ItemTemplate="{StaticResource PreviewRowTemplate}" />
                            </StackPanel>

                            <TextBlock Text="書き込み先" FontSize="11" FontWeight="SemiBold" Foreground="#444444" Margin="0,12,0,3" />
                            <ItemsControl ItemsSource="{Binding PreviewFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="10" Foreground="#666666" Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Action}" FontSize="10" Foreground="#3050CC" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding RelPath}" FontSize="10.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelPath}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#444444" Margin="0,12,0,3">
                                <Run Text="警告・情報 (" /><Run Text="{Binding WarningCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PreviewMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="0,0,0,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666666" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#9A6700" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Foreground" Value="#C04040" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding SeverityLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="手動作業" FontSize="11" FontWeight="SemiBold" Foreground="#444444" Margin="0,12,0,3" />
                            <ItemsControl ItemsSource="{Binding ManualTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="10.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,3">
                                            <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
