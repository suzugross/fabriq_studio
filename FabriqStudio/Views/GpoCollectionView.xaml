<UserControl x:Class="FabriqStudio.Views.GpoCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FabriqStudio.Views">
    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="📜 GPO 辞書" FontSize="18" FontWeight="Bold" Foreground="#2D2D30" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="ADMX（管理用テンプレート）から生成したローカル グループポリシーの辞書。検索して状態を決め、gpo_config/gpo_list.csv へ書き出します" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#107C10" FontSize="12" VerticalAlignment="Center"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTip="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="ADMX フォルダー" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="🔄 再読込" Command="{Binding ReloadCommand}" Padding="10,3" FontSize="11" Margin="6,0,0,0" Cursor="Hand"
                            ToolTip="このフォルダーの ADMX/ADML を読み直します（フォルダーは記憶されます）" />
                    <Button DockPanel.Dock="Right" Content="既定に戻す" Command="{Binding UseDefaultSourceCommand}" Padding="10,3" FontSize="11" Margin="6,0,0,0" Cursor="Hand"
                            ToolTip="C:\Windows\PolicyDefinitions" />
                    <Button DockPanel.Dock="Right" Content="参照..." Command="{Binding BrowseSourceCommand}" Padding="10,3" FontSize="11" Margin="6,0,0,0" Cursor="Hand" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CatalogInfo}" FontSize="10.5" Foreground="#666666" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding CatalogInfo}" />
                    <TextBox Text="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Padding="4,3" FontFamily="Consolas"
                             MinWidth="360" MaxWidth="560" HorizontalAlignment="Left" BorderBrush="#CCCCCC"
                             ToolTip="既定は C:\Windows\PolicyDefinitions。ドメインのセントラル ストア（\\domain\SYSVOL\...\PolicyDefinitions）も指定できます" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 本体: 検索一覧 | 詳細・設定・書き出し -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                <views:GpoBrowserControl DataContext="{Binding Browser}" />
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,10">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right" Content="📤 gpo_list.csv へ追加" Command="{Binding ExportCommand}"
                                    Padding="14,5" FontSize="12" Background="#107C10" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ExportHint}" FontSize="10.5" Foreground="#666666" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="640" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <views:GpoPolicyConfigControl DataContext="{Binding Config}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
