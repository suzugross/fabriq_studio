<UserControl x:Class="FabriqStudio.Views.CollectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Padding"         Value="14,6" />
            <Setter Property="FontSize"        Value="12.5" />
            <Setter Property="Background"      Value="#007ACC" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="MinWidth"        Value="150" />
            <Setter Property="Content"         Value="{Binding ButtonText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Content" Value="実行中…" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F3F3F3">
        <StackPanel Margin="20" MaxWidth="860" HorizontalAlignment="Left">

            <!-- 見出し + 対象プロファイル -->
            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="採取" FontSize="20" FontWeight="Bold" Foreground="#2D2D30" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="13" Foreground="#555555"
                           Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Run Text="プロファイル: " /><Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2D2D30" />
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="13" Foreground="#C62828"
                           Text="基本パラメータでプロファイルを選んでください"
                           Visibility="{Binding HasProfile, Converter={StaticResource BoolToCollapsedConverter}}" />
            </DockPanel>

            <!-- 採取の種類 -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2D2D30" />
                                    <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Status, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#888888" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Detail, Converter={StaticResource NullToCollapsedConverter}}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource RunButton}" Command="{Binding RunCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
