<UserControl x:Class="FabriqStudio.Views.AppConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Margin"     Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="White" />
            <Setter Property="BorderBrush"     Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="4" />
            <Setter Property="Padding"         Value="14" />
            <Setter Property="Margin"          Value="0,0,0,10" />
        </Style>

        <!-- Type 列の ComboBox 選択肢 -->
        <x:Array x:Key="InstallerTypes" Type="{x:Type sys:String}">
            <sys:String>exe</sys:String>
            <sys:String>msi</sys:String>
            <sys:String>bat</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダーバー ===== -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">

                <!-- 左 -->
                <Button DockPanel.Dock="Left"
                        Content="← 戻る"
                        Command="{Binding NavigateBackCommand}"
                        Padding="12,5" FontSize="12"
                        Background="Transparent" BorderBrush="#AAAAAA"
                        Cursor="Hand" />
                <TextBlock DockPanel.Dock="Left"
                           Text="アプリ設定"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#2D2D30"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Module.ModuleDir, StringFormat=' [{0}]'}"
                           FontSize="14" Foreground="#007ACC"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0" />
                <Border DockPanel.Dock="Left"
                        Background="#EEF0FF" CornerRadius="3"
                        Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Module.Kind}"
                               FontSize="11" Foreground="#3050CC" />
                </Border>

                <!-- 編集先データセット: 本体（既定値）か、プロファイルのデータフォルダ（PDF）か -->
                <Border DockPanel.Dock="Left" CornerRadius="3"
                        Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0"
                        ToolTip="プロファイルの行の ⚙ から開くとそのプロファイルのデータフォルダ（profiles/&lt;名&gt;/modules/）を、Advanced のモジュール編集から開くと本体（modules/）を編集します">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EEEEEE" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProfileContext}" Value="True">
                                    <Setter Property="Background" Value="#E3F2E6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DataSetLabel}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#555555" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileContext}" Value="True">
                                        <Setter Property="Foreground" Value="#2F5D3A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 右: ロック / 保存ボタン / ステータス / Dirty -->
                <ToggleButton DockPanel.Dock="Right"
                              IsChecked="{Binding IsLocked}"
                              IsEnabled="{Binding IsFallbackView,
                                  Converter={StaticResource InverseBooleanConverter}}"
                              Padding="10,4" FontSize="12" Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="🔒 ロック中（読み取り専用）" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Content" Value="✏️ 編集中" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Button DockPanel.Dock="Right"
                        Content="💾 保存"
                        Command="{Binding SaveCommand}"
                        Padding="14,5" FontSize="12"
                        Background="#007ACC" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SaveStatus}"
                           Foreground="#107C10" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding SaveStatus,
                               Converter={StaticResource NullToCollapsedConverter}}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SaveError}"
                           Foreground="Red" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding SaveError,
                               Converter={StaticResource NullToCollapsedConverter}}" />

                <!-- ローディング / エラー / Dirty -->
                <TextBlock DockPanel.Dock="Right"
                           Text="読み込み中..."
                           Foreground="#888888" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsLoading,
                               Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ErrorMessage}"
                           Foreground="Red" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource NullToCollapsedConverter}}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="● 未保存の変更があります"
                           Foreground="OrangeRed" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGuideDirty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasCsvChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- 案内バナー群（Row 1）
             1) PDF 上書き警告: 本体側の編集画面で、profiles/<名>/modules/ が上書きしているとき（前倒しの注意喚起）
             2) フォールバック: プロファイル文脈で CSV がまだ PDF に無いとき（本体を読み取り専用で表示 → 取り込んで編集）
             3) 取り込み直後: サンプル行の整理を促す -->
        <StackPanel Grid.Row="1">
            <Border Background="#FFF8E1" BorderBrush="#F0C36D" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding OverrideSummary}"
                               FontSize="12" Foreground="#6B4F00" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CsvOverrideNote}"
                               FontSize="11" Foreground="#8A6D00" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding CsvOverrideNote, Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>
            </Border>
            <Border Background="#E8F1FB" BorderBrush="#9DBEE3" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding IsFallbackView, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="取り込んで編集"
                            Command="{Binding ImportCsvCommand}"
                            Padding="10,3" FontSize="11" Cursor="Hand"
                            Background="#1E6FBF" Foreground="White" BorderThickness="0" />
                    <TextBlock Text="{Binding FallbackNote}"
                               FontSize="12" Foreground="#1F3A5F" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </Border>
            <Border Background="#E3F2E6" BorderBrush="#9CCB9F" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding ImportedNote, Converter={StaticResource NullToCollapsedConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="サンプル行を削除"
                            Command="{Binding RemoveSampleRowsCommand}"
                            Padding="10,3" FontSize="11" Cursor="Hand" />
                    <TextBlock Text="{Binding ImportedNote}"
                               FontSize="12" Foreground="#2F5D3A" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== コンテンツ ===== -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- ─── 上段: guide.txt（左）+ module.csv メタ（右）─── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- guide.txt -->
                <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="guide.txt"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left"
                                       Text="● 未保存"
                                       Foreground="OrangeRed" FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsGuideDirty,
                                           Converter={StaticResource BoolToVisibilityConverter}}" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="guide.txt が見つかりません"
                                   Foreground="#AAAAAA" FontStyle="Italic" FontSize="12"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasGuideText,
                                       Converter={StaticResource BoolToCollapsedConverter}}" />

                        <TextBox Text="{Binding GuideText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsLocked}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasGuideText,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background"  Value="#F8F8F8" />
                                    <Setter Property="BorderBrush" Value="#CCCCCC" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                            <Setter Property="Background"  Value="White" />
                                            <Setter Property="BorderBrush" Value="#007ACC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>
                </Border>

                <!-- module.csv メタ情報 -->
                <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="module.csv" Style="{StaticResource SectionHeaderStyle}" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="メニュー名:" Width="80" FontSize="11" Foreground="#666" />
                            <TextBox Text="{Binding Module.MenuName}" IsReadOnly="True" FontSize="11" Padding="3,2" BorderBrush="#CCC" Background="#F8F8F8" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="カテゴリ:" Width="80" FontSize="11" Foreground="#666" />
                            <TextBox Text="{Binding Module.Category}" IsReadOnly="True" FontSize="11" Padding="3,2" BorderBrush="#CCC" Background="#F8F8F8" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="スクリプト:" Width="80" FontSize="11" Foreground="#666" />
                            <TextBox Text="{Binding Module.Script}" IsReadOnly="True" FontSize="11" Padding="3,2" BorderBrush="#CCC" Background="#F8F8F8" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="順序:" Width="80" FontSize="11" Foreground="#666" />
                            <TextBox Text="{Binding Module.Order}" IsReadOnly="True" FontSize="11" Padding="3,2" BorderBrush="#CCC" Background="#F8F8F8" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="有効:" Width="80" FontSize="11" Foreground="#666" />
                            <TextBox Text="{Binding Module.Enabled}" IsReadOnly="True" FontSize="11" Padding="3,2" BorderBrush="#CCC" Background="#F8F8F8" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─── 下段: アプリ一覧 CSV ─── -->
            <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="アプリ一覧"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding ConfigCsvFileName, StringFormat=' ({0})'}"
                                   FontSize="11" Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasConfigCsv,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- 採用元（PDF 文脈のみ）: データフォルダ / 本体（未取り込み） -->
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding CsvSourceLabel}"
                                   FontSize="11" Foreground="#2F5D3A"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding CsvSourceLabel,
                                       Converter={StaticResource NullToCollapsedConverter}}" />

                        <!-- CSV Dirty インジケーター -->
                        <TextBlock DockPanel.Dock="Left"
                                   Text="● 未保存"
                                   Foreground="OrangeRed" FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding HasCsvChanges,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- 右: インストーラー追加ボタン -->
                        <Button DockPanel.Dock="Right"
                                Content="📦 インストーラーを追加"
                                Command="{Binding ImportInstallerCommand}"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                VerticalAlignment="Center"
                                Background="#107C10" Foreground="White"
                                BorderThickness="0" />

                        <!-- 右: 行追加ボタン -->
                        <Button DockPanel.Dock="Right"
                                Content="＋ 行追加"
                                Command="{Binding AddCsvRowCommand}"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" />

                        <!-- 右: 行削除ボタン -->
                        <Button DockPanel.Dock="Right"
                                Content="🗑 行削除"
                                Command="{Binding DeleteCsvRowCommand}"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" />
                    </DockPanel>

                    <!-- 設定CSVなし -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="設定CSVが見つかりません（module.csv 以外のCSVが存在しない）"
                               Foreground="#AAAAAA" FontStyle="Italic" FontSize="12"
                               Visibility="{Binding HasConfigCsv,
                                   Converter={StaticResource BoolToCollapsedConverter}}" />

                    <!-- アプリ一覧 DataGrid: 明示的カラム定義
                         - Enabled 列はチェックボックス（プロファイル編集画面と同パターン） -->
                    <DataGrid ItemsSource="{Binding ConfigCsvData.DefaultView}"
                              SelectedItem="{Binding SelectedCsvRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="{Binding IsLocked}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              BorderBrush="#DDDDDD" BorderThickness="1"
                              Visibility="{Binding HasConfigCsv,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                        <!--
                            Enabled=0 の行をグレーアウト（プロファイル編集画面と同パターン）。
                            DataRowView へは indexer `[Enabled]` でアクセスし、セル値は文字列 "0"/"1"。
                            IsSelected Trigger を後勝ちで置き、選択行は通常色で WPF 標準ハイライトを維持する。
                        -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding [Enabled]}" Value="0">
                                        <Setter Property="Foreground" Value="#999999" />
                                        <Setter Property="Opacity"    Value="0.6" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="Opacity"    Value="1.0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- 「有効」列: string "0"/"1" と CheckBox の双方向バインド
                                 プロファイル編集画面の「有効」列と同一パターン -->
                            <DataGridTemplateColumn Header="有効" Width="50" SortMemberPath="Enabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding [Enabled],
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged,
                                                      Converter={StaticResource StringOneToBoolConverter}}"
                                                  IsHitTestVisible="{Binding DataContext.IsLocked,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                                      Converter={StaticResource InverseBooleanConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="アプリ名"
                                                Binding="{Binding AppName}"
                                                Width="160" />
                            <DataGridTextColumn Header="ファイル名"
                                                Binding="{Binding FileName}"
                                                Width="220" />
                            <DataGridComboBoxColumn Header="タイプ"
                                                    SelectedItemBinding="{Binding Type}"
                                                    ItemsSource="{StaticResource InstallerTypes}"
                                                    Width="70" />
                            <DataGridTextColumn Header="サイレント引数"
                                                Binding="{Binding SilentArgs}"
                                                Width="*" />
                            <DataGridTextColumn Header="説明"
                                                Binding="{Binding Description}"
                                                Width="160" />
                            <DataGridTextColumn Header="Segment"
                                                Binding="{Binding Segment}"
                                                Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
