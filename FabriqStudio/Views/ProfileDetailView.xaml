<UserControl x:Class="FabriqStudio.Views.ProfileDetailView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helpers="clr-namespace:FabriqStudio.Helpers">

    <UserControl.Resources>
        <x:Array x:Key="ErrorModeOptions" Type="sys:String">
            <sys:String>ask</sys:String>
            <sys:String>skip</sys:String>
            <sys:String>retry</sys:String>
        </x:Array>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Margin"     Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="White" />
            <Setter Property="BorderBrush"     Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="4" />
            <Setter Property="Padding"         Value="12" />
            <Setter Property="Margin"          Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダーバー ===== -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">

                <!-- 左: 戻る / タイトル / プロファイル名 -->
                <Button DockPanel.Dock="Left"
                        Content="← 戻る"
                        Command="{Binding NavigateBackCommand}"
                        Padding="12,5" FontSize="12"
                        Background="Transparent" BorderBrush="#AAAAAA"
                        Cursor="Hand" />
                <TextBlock DockPanel.Dock="Left"
                           Text="プロファイル編集"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#2D2D30"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Profile.Name, StringFormat=' [{0}]'}"
                           FontSize="14" Foreground="#007ACC"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0" />

                <!-- データフォルダ（PDF）の有無。あれば行の ⚙ の編集先はそちらになる -->
                <Border DockPanel.Dock="Left" CornerRadius="3"
                        Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0"
                        ToolTip="profiles/&lt;名&gt;/modules/ にモジュールの設定 CSV・資材を置くと、このプロファイルの実行ではそちらが本体より優先されます。行の ⚙ はこのフォルダを編集します">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EEEEEE" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDataFolder}" Value="True">
                                    <Setter Property="Background" Value="#E3F2E6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DataFolderLabel}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#555555" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDataFolder}" Value="True">
                                        <Setter Property="Foreground" Value="#2F5D3A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 右: ロック / 保存 / Dirty / ステータス -->
                <ToggleButton DockPanel.Dock="Right"
                              IsChecked="{Binding IsLocked}"
                              Padding="10,4" FontSize="12" Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="🔒 ロック中（読み取り専用）" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Content" Value="✏️ 編集中" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Button DockPanel.Dock="Right"
                        Content="💾 保存"
                        Command="{Binding SaveCommand}"
                        Padding="14,5" FontSize="12"
                        Background="#007ACC" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SaveStatus}"
                           Foreground="#107C10" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding SaveStatus,
                               Converter={StaticResource NullToCollapsedConverter}}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SaveError}"
                           Foreground="Red" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding SaveError,
                               Converter={StaticResource NullToCollapsedConverter}}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="● 未保存の変更があります"
                           Foreground="OrangeRed" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock DockPanel.Dock="Right"
                           Text="読み込み中..."
                           Foreground="#888888" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsLoading,
                               Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ErrorMessage}"
                           Foreground="Red" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource NullToCollapsedConverter}}" />
            </DockPanel>
        </Border>

        <!-- ===== データフォルダ（PDF）の案内: 旧形式の変換 / 未取り込み / 未使用 ===== -->
        <StackPanel Grid.Row="1">

            <!-- 旧形式: PDF が無くモジュール行がある → 一括変換を訊く（断れば行の ⚙ から 1 モジュールずつ） -->
            <Border Background="#E8F1FB" BorderBrush="#9DBEE3" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding ShowConvertBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="今はしない"
                            Command="{Binding DismissConvertBannerCommand}"
                            Padding="10,3" FontSize="11" Cursor="Hand" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="取り込んでデータフォルダを作成"
                            Command="{Binding MaterializeAllCommand}"
                            Padding="10,3" FontSize="11" Cursor="Hand"
                            Background="#1E6FBF" Foreground="White" BorderThickness="0" />
                    <TextBlock FontSize="12" Foreground="#1F3A5F" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="このプロファイルにはデータフォルダ（profiles/&lt;名&gt;/）がありません。使用中の " /><Run Text="{Binding MissingModules.Count, Mode=OneWay}" /><Run Text=" モジュールの設定 CSV を本体から取り込んで、プロファイル別データフォルダの形式に変換しますか？ 内容はそのままコピーするので実行結果は変わりません。断った場合も、行の ⚙ から 1 モジュールずつ取り込めます。" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- PDF はあるが未取り込みのモジュールがある（実行時は本体にフォールバックし fabriq が警告する） -->
            <Border Background="#FFF8E1" BorderBrush="#F0C36D" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding ShowMissingBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="取り込む"
                            Command="{Binding MaterializeAllCommand}"
                            Padding="10,3" FontSize="11" Cursor="Hand" />
                    <TextBlock FontSize="12" Foreground="#6B4F00" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="データフォルダに未取り込みのモジュールがあります（実行時は本体の設定にフォールバックし、警告が出ます）: " /><Run Text="{Binding MissingSummary, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- PDF にあるが使っていないモジュール（自動では消さない。明示操作で削除） -->
            <Border Background="#F4F4F4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="16,6"
                    Visibility="{Binding HasUnusedModules, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="データフォルダにあるが使っていないモジュール: "
                               FontSize="11" Foreground="#666666"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding UnusedModules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                                        CornerRadius="3" Padding="6,1" Margin="0,0,6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                                        <Button Content="✕" FontSize="10" Padding="4,0" Margin="6,0,0,0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                ToolTip="このモジュールのデータフォルダを削除する（元に戻せません）"
                                                Command="{Binding DataContext.DeleteUnusedModuleDataCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== コンテンツ: 左右 2ペイン ===== -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ─── 左ペイン: 利用可能モジュール ─── -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                <DockPanel>

                    <!-- タイトル -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="利用可能モジュール"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <!-- フィルター TextBox -->
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11"
                             Padding="5,4"
                             BorderBrush="#CCCCCC"
                             Margin="0,0,0,6">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <!-- プレースホルダー代替: 空のときは薄いヒント文字 -->
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- フィルターヒント -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="（名前 / カテゴリ / フォルダ名でフィルター）"
                               FontSize="9" Foreground="#AAAAAA"
                               Margin="0,0,0,6" />

                    <!-- 追加ボタン -->
                    <Button DockPanel.Dock="Bottom"
                            Content="→ プロファイルに追加"
                            Command="{Binding AddModuleCommand}"
                            Padding="8,5" FontSize="11" Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Background="#107C10" Foreground="White"
                            BorderThickness="0"
                            Margin="0,6,0,0" />

                    <!-- 件数表示 -->
                    <TextBlock DockPanel.Dock="Bottom"
                               FontSize="10" Foreground="#888888"
                               Margin="0,4,0,0" HorizontalAlignment="Right">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} 件">
                                <Binding Path="FilteredModules.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- モジュール ListBox
                         ItemContainerStyle + EventSetter で ListBoxItem の MouseDoubleClick を
                         code-behind にフック（ListBox レベルの MouseBinding は ListBoxItem に
                         イベントを消化されて発火しないため、item-level で拾う）。
                         空領域ダブルクリックは ListBoxItem が存在しないため発火しない。 -->
                    <ListBox ItemsSource="{Binding FilteredModules}"
                             SelectedItem="{Binding SelectedAvailable, Mode=TwoWay}"
                             BorderBrush="#DDDDDD" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="MouseDoubleClick"
                                             Handler="ModuleItem_MouseDoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   FontSize="9" Foreground="#5C2D91"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="9" Foreground="#888888"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SubText}"
                                                   FontSize="9" Foreground="#AAAAAA"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─── 右ペイン: プロファイル構成 ─── -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <DockPanel>

                    <!-- ヘッダー行: タイトル + 操作ボタン群 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="モジュール構成"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left"
                                   Text="● 未保存"
                                   Foreground="OrangeRed" FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding IsDirty,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- 右: 特殊コマンド ComboBox + 追加ボタン -->
                        <ComboBox DockPanel.Dock="Right"
                                  ItemsSource="{Binding SpecialCommands}"
                                  SelectedItem="{Binding SelectedSpecialCommand, Mode=TwoWay}"
                                  DisplayMemberPath="Command"
                                  Width="160" FontSize="11"
                                  Margin="0,0,0,0" />
                        <Button DockPanel.Dock="Right"
                                Content="特殊コマンド追加"
                                Command="{Binding AddSpecialCommandCommand}"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                Margin="0,0,6,0" />

                        <!-- 右: 削除 / 上 / 下 -->
                        <Button DockPanel.Dock="Right"
                                Content="🗑 削除"
                                Command="{Binding RemoveModuleCommand}"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right"
                                Content="📥 インポート"
                                Command="{Binding ImportProfileCommand}"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                Margin="0,0,6,0" />
                        <!--
                            Focusable=False: 移動ボタン押下時にフォーカスを DataGrid に留め、
                            Selector.IsSelectionActive=True を維持する（選択色が薄くならない対策）。
                        -->
                        <Button DockPanel.Dock="Right"
                                Content="↓"
                                Command="{Binding MoveDownCommand}"
                                Focusable="False"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                Margin="0,0,4,0" />
                        <Button DockPanel.Dock="Right"
                                Content="↑"
                                Command="{Binding MoveUpCommand}"
                                Focusable="False"
                                Padding="8,3" FontSize="11" Cursor="Hand"
                                Margin="0,0,6,0" />
                    </DockPanel>

                    <!-- プロファイル DataGrid
                         - DataGridRowDragDropBehavior で行の D&D 並べ替えを有効化
                         - IsLocked=True 時は IsEnabled=False で D&D 抑止 -->
                    <DataGrid ItemsSource="{Binding Modules}"
                              SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                              IsReadOnly="{Binding IsLocked}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#DDDDDD" BorderThickness="1"
                              SelectionMode="Single"
                              helpers:DataGridRowDragDropBehavior.IsEnabled="{Binding IsLocked,
                                  Converter={StaticResource InverseBooleanConverter}}"
                              helpers:DataGridRowDragDropBehavior.MoveCommand="{Binding MoveRowCommand}">
                        <!--
                            DataGridCell のデフォルトスタイルは SystemColors のキーを参照して
                            選択時の背景色（Active=青 / Inactive=薄グレー）を決定する。
                            この DataGrid のスコープ内で両キーを同じ色にオーバーライドすることで、
                            移動ボタン押下・D&D・他コントロールへのフォーカス移動時でも
                            選択行のハイライトが常に同じ濃い色で維持される。
                        -->
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                  Color="#3399FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"              Color="White"   />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                        </DataGrid.Resources>
                        <!-- AlternatingRowBackground は SpecialMarkerToBackgroundConverter と競合するため使用しない -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <!-- Background: ScriptPath + Group を MultiConverter で評価
                                     優先順 (1) 特殊マーカー → 青 (2) Group 値あり → パレット色 (3) その他 → 透明 -->
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource GroupRowBackgroundConverter}">
                                            <Binding Path="ScriptPath" />
                                            <Binding Path="Group" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- FontStyle: 特殊マーカー行すべてにイタリックを適用 -->
                                    <DataTrigger Binding="{Binding IsSystemCommand}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                    <!-- 無効化された行のグレーアウト -->
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Foreground" Value="#999999" />
                                        <Setter Property="Opacity"    Value="0.6" />
                                    </DataTrigger>
                                    <!--
                                        選択行のハイライト（IsSelectionActive 非依存）。
                                        移動ボタンクリックや将来の D&D 操作でフォーカスが DataGrid から外れても、
                                        選択行が視覚的に常に明確に識別できるようにする。
                                        後勝ちの原則で IsEnabled=False DataTrigger より後に配置し、
                                        無効化+選択の組み合わせでも選択色を優先させる。
                                    -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3399FF" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Opacity"    Value="1.0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="順序"
                                                Binding="{Binding Order}"
                                                Width="55" />
                            <DataGridTemplateColumn Header="有効" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="{Binding DataContext.IsLocked,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                                      Converter={StaticResource InverseBooleanConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="スクリプト / コマンド"
                                                Binding="{Binding ScriptPath}"
                                                Width="*" />
                            <DataGridTextColumn Header="説明"
                                                Binding="{Binding Description}"
                                                Width="200" />
                            <!-- セグメント: 参照モジュールの設定 CSV に実在する Segment 値をプリセット表示。
                                 自由入力可（IsEditable=True）。候補は行ごとに異なるため ItemsSource は
                                 行の DataContext の SegmentOptions を参照する。
                                 DataGridComboBoxColumn では IsEditable が素直に効かないため Template 列で実装。 -->
                            <DataGridTemplateColumn Header="セグメント" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding Segment, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  ItemsSource="{Binding SegmentOptions}"
                                                  IsHitTestVisible="{Binding DataContext.IsLocked,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                                      Converter={StaticResource InverseBooleanConverter}}"
                                                  BorderThickness="0" Background="Transparent"
                                                  Padding="2,0" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Group: kernel 3.2.0 任意列。プリセット 5 種 + 自由入力可（IsEditable=True）。
                                 DataGridComboBoxColumn では IsEditable が素直に効かないため Template 列で実装。 -->
                            <DataGridTemplateColumn Header="Group" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  ItemsSource="{Binding DataContext.AvailableGroups,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  IsHitTestVisible="{Binding DataContext.IsLocked,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                                      Converter={StaticResource InverseBooleanConverter}}"
                                                  BorderThickness="0" Background="Transparent"
                                                  Padding="2,0" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="メモ"
                                                Binding="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                                Width="150" />
                            <DataGridComboBoxColumn Header="エラー時"
                                                    SelectedItemBinding="{Binding ErrorMode, UpdateSourceTrigger=LostFocus}"
                                                    ItemsSource="{StaticResource ErrorModeOptions}"
                                                    Width="80" />
                            <!-- ⚙ 設定ボタン（通常モジュールのみ表示） -->
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚙"
                                                FontSize="13" Padding="2,0" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding DataContext.OpenModuleSettingsCommand,
                                                    ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystemCommand}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
