<Window x:Class="FabriqStudio.Views.MasterPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="980" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="DlgButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaneHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin"     Value="0,0,0,4" />
        </Style>
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF" />
            <Setter Property="BorderBrush"     Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="4" />
            <Setter Property="Padding"         Value="10,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 概要 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#222222" />
            <TextBlock FontSize="12" Foreground="#C04040" FontWeight="SemiBold" Margin="0,4,0,0"
                       Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                <Run Text="⛔ エラー " /><Run Text="{Binding ErrorCount, Mode=OneWay}" /><Run Text=" 件のため生成できません。画面に戻って修正してください。" />
            </TextBlock>
        </StackPanel>

        <!-- 本体: 左 = プロファイル行 / 右 = ファイル + 警告 + 手動 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Pane}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="生成されるプロファイル行" Style="{StaticResource PaneHeader}" />
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              FontSize="11.5" Background="White" BorderThickness="0" HorizontalGridLinesBrush="#EEEEEE"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMarker}" Value="True">
                                        <Setter Property="Background" Value="#DAE8FC" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="プロファイル" Binding="{Binding Profile}" Width="130" />
                            <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="55" />
                            <DataGridTextColumn Header="ScriptPath" Binding="{Binding ScriptPath}" Width="*" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="170" />
                            <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="110" />
                            <DataGridTextColumn Header="ErrorMode" Binding="{Binding ErrorMode}" Width="70" />
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" MaxHeight="160" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Pane}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="書き込み先ファイル" Style="{StaticResource PaneHeader}" />
                        <ListView ItemsSource="{Binding Files}" BorderThickness="0" FontSize="11">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ファイル" Width="220" DisplayMemberBinding="{Binding RelPath}" />
                                    <GridViewColumn Header="操作" Width="50" DisplayMemberBinding="{Binding Action}" />
                                    <GridViewColumn Header="内容" Width="90" DisplayMemberBinding="{Binding Detail}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Pane}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <Run Text="警告・情報（警告 " /><Run Text="{Binding WarningCount, Mode=OneWay}" /><Run Text=" 件）" />
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666666" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#9A6700" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Foreground" Value="#C04040" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding SeverityLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Pane}"
                        Visibility="{Binding HasManual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="手動作業（fabriq の対象外）" Style="{StaticResource PaneHeader}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ManualTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,3">
                                            <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 進捗 / 結果 -->
        <TextBlock Grid.Row="4" Text="{Binding ProgressText}" FontSize="12" Foreground="#222222"
                   Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsedConverter}}" />

        <!-- ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource DlgButtonStyle}" Content="閉じる"
                    Background="#E0E0E0" Foreground="#333333" Padding="16,6"
                    Command="{Binding CloseCommand}" IsCancel="True" />
            <Button Style="{StaticResource DlgButtonStyle}" Content="生成（ファイルに書き込む）"
                    Background="#107C10" Foreground="#FFFFFF" Padding="16,6" Margin="8,0,0,0"
                    Command="{Binding ApplyCommand}" />
        </StackPanel>
    </Grid>
</Window>
