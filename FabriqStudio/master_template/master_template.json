{
  "version": 2,
  "sections": [
    {
      "id": "run",
      "title": "A. 実行設定",
      "group": "",
      "description": "マスタ作成は組み込み Administrator でサインインして Fabriq を実行する前提です。__RESTART__ の後は同じアカウントでサインインし直すと、Fabriq が RunOnce から自動で再開します。",
      "items": [
        { "id": "autopilot_wait", "type": "number", "label": "AutoPilot のモジュール間ウェイト", "default": "3", "unit": "秒", "target": "__AUTOPILOT__ WaitSec", "kind": "module", "subgroup": "AutoPilot" }
      ]
    },
    {
      "id": "bios",
      "title": "1. BIOS 設定",
      "group": "",
      "items": [
        { "id": "bios_note", "type": "multiline", "label": "BIOS 設定（記入内容は手動作業リストに出力）", "target": "手動作業", "kind": "manual", "placeholder": "例: セキュアブート有効 / 起動順序 / 仮想化支援 ON", "subgroup": "BIOS" }
      ]
    },
    {
      "id": "os",
      "title": "2. OS 情報",
      "group": "Base",
      "items": [
        { "id": "os_info", "type": "text", "label": "OS / エディション / アーキテクチャ / バージョン", "target": "記録のみ（evidence_config が実機値を収集）", "kind": "manual", "placeholder": "例: Windows 11 Pro 64bit 24H2", "subgroup": "OS" },
        { "id": "os_product_key", "type": "text", "label": "OS ライセンスキー", "secret": true, "target": "windows_license_config", "kind": "module", "placeholder": "XXXXX-XXXXX-XXXXX-XXXXX-XXXXX（空欄=キー投入なし）", "subgroup": "ライセンス" },
        { "id": "os_activate", "type": "bool", "label": "Windows ライセンス認証を実行する", "default": "1", "target": "windows_license_auth", "kind": "module", "subgroup": "ライセンス" }
      ]
    },
    {
      "id": "drive",
      "title": "3. ドライブ構成・パーティション設定",
      "group": "Base",
      "items": [
        { "id": "part_enabled", "type": "bool", "label": "C: を縮小して追加パーティションを作成する", "default": "0", "target": "partition_config", "kind": "module", "subgroup": "パーティション" },
        { "id": "part_c_size_gb", "type": "number", "label": "プライマリ C: の容量", "unit": "GB（縮小後）", "visibleWhen": { "item": "part_enabled", "values": ["1"] }, "subgroup": "パーティション" },
        { "id": "part_new_letter", "type": "text", "label": "拡張パーティション ドライブレター", "default": "D", "visibleWhen": { "item": "part_enabled", "values": ["1"] }, "subgroup": "パーティション" },
        { "id": "part_new_size_gb", "type": "number", "label": "拡張パーティション 容量", "default": "0", "unit": "GB（0 = 残り全部）", "visibleWhen": { "item": "part_enabled", "values": ["1"] }, "subgroup": "パーティション" },
        { "id": "part_label", "type": "text", "label": "拡張パーティション ボリュームラベル", "default": "Data", "visibleWhen": { "item": "part_enabled", "values": ["1"] }, "subgroup": "パーティション" },
        { "id": "optical_letter", "type": "text", "label": "光学ドライブ ドライブレター", "target": "手動作業（fabriq 側拡張候補）", "kind": "fabriq", "placeholder": "例: Q:", "subgroup": "光学ドライブ" }
      ]
    },
    {
      "id": "pcname",
      "title": "4. コンピューター名設定",
      "group": "Base",
      "description": "納品端末のコンピューター名と IP は端末ごとの値のため、端末一覧（kernel/csv/hostlist.csv）で管理し、配備プロファイルで適用します。ここではマスタ作成中に使う仮のコンピューター名を指定します。",
      "items": [
        { "id": "master_hostname", "type": "text", "label": "マスタ作成時の仮コンピューター名", "target": "hostlist.csv（管理番号 = マスタ名）+ hostname_config", "kind": "module", "placeholder": "例: MASTER01（半角英数字とハイフン、15 文字以内。空欄 = 変更しない）", "help": "hostlist.csv に管理番号＝マスタ名の行として書き込みます。Fabriq 起動時のホスト選択でその行を選ぶと hostname_config が適用します。", "subgroup": "マスタ作成時の仮ホスト名" }
      ]
    },
    {
      "id": "network",
      "title": "5. ネットワーク設定（イーサネット・Wi-Fi）",
      "group": "Base",
      "description": "IPv4 アドレス・サブネット・ゲートウェイ・DNS は端末一覧（hostlist.csv）の値が ipaddress_config で適用されます。",
      "items": [
        { "id": "ipv6", "type": "choice", "label": "IP アドレス（v6）", "default": "1", "target": "ipv6_config", "kind": "module", "subgroup": "IPv6",
          "options": [ { "value": "1", "label": "有効（既定）" }, { "value": "0", "label": "無効（有線・無線とも）" } ] },
        { "id": "ntp_enabled", "type": "bool", "label": "時刻同期（NTP サーバー）を設定する", "default": "0", "target": "time_sync_config", "kind": "module", "subgroup": "時刻同期" },
        { "id": "ntp_server", "type": "text", "label": "NTP サーバー", "default": "time.windows.com", "visibleWhen": { "item": "ntp_enabled", "values": ["1"] }, "subgroup": "時刻同期" }
      ]
    },
    {
      "id": "users",
      "title": "6. ユーザーアカウント設定",
      "group": "Account",
      "description": "マスタ作成は組み込み Administrator で行います。ここでは納品時の Administrator の状態と、組み込み Administrator 以外に必要なローカルユーザーを指定します。",
      "items": [
        { "id": "admin_enable", "type": "bool", "label": "組み込み Administrator を有効にし、パスワードを設定する", "default": "0", "target": "builtin_admin_config", "kind": "module", "help": "無効（既定）のままにする場合は行を出しません。builtin_admin_config は有効化とパスワード設定のみで、無効化は行いません。", "subgroup": "組み込み Administrator" },
        { "id": "admin_password", "type": "text", "label": "Administrator パスワード", "secret": true, "visibleWhen": { "item": "admin_enable", "values": ["1"] }, "subgroup": "組み込み Administrator" },
        { "id": "admin_never_expires", "type": "bool", "label": "Administrator のパスワードを無期限にする", "default": "1", "visibleWhen": { "item": "admin_enable", "values": ["1"] }, "subgroup": "組み込み Administrator" },
        { "id": "block_msa", "type": "bool", "label": "Microsoft アカウントをブロックする（追加もサインインも不可）", "default": "0", "target": "辞書 NoConnectedUser", "kind": "dict", "subgroup": "Microsoft アカウント",
          "registryTrue": [ { "id": "000000f4", "value": "3" } ] },
        { "id": "local_users", "type": "table", "label": "追加するローカルユーザー（組み込み Administrator 以外の管理者など）", "target": "local_user_config", "kind": "module", "subgroup": "追加ユーザー",
          "columns": [
            { "name": "UserName", "label": "ユーザー名" },
            { "name": "Password", "label": "パスワード", "secret": true },
            { "name": "Group", "label": "所属グループ", "options": ["Administrators", "Users"], "default": "Administrators" },
            { "name": "PasswordNeverExpires", "label": "パスワード無期限", "options": ["1", "0"], "default": "1" },
            { "name": "Description", "label": "備考" }
          ] }
      ]
    },
    {
      "id": "system",
      "title": "7. システム関連設定",
      "group": "System / Registry",
      "items": [
        { "id": "remote_assist", "type": "choice", "label": "リモートアシスタンス", "default": "1", "target": "辞書 fAllowToGetHelp", "kind": "dict", "subgroup": "リモート接続",
          "options": [ { "value": "1", "label": "許可する（既定）" }, { "value": "0", "label": "許可しない", "registry": [ { "id": "000000f3", "value": "0" } ] } ] },
        { "id": "rdp", "type": "choice", "label": "リモートデスクトップ", "default": "0", "target": "辞書 2 件 + firewall_rule_make_config", "kind": "dict", "subgroup": "リモート接続",
          "options": [
            { "value": "0", "label": "このコンピューターへの接続を許可しない（既定）" },
            { "value": "1", "label": "リモートデスクトップを実行しているコンピューターからの接続を許可", "registry": [ { "id": "00000001", "value": "0" }, { "id": "000000f5", "value": "0" } ] },
            { "value": "2", "label": "ネットワークレベル認証コンピューターからのみ接続を許可", "registry": [ { "id": "00000001", "value": "0" }, { "id": "000000f5", "value": "1" } ] }
          ] },
        { "id": "fw_domain", "type": "choice", "label": "ドメインプロファイル", "default": "on", "target": "firewall_config", "kind": "module", "subgroup": "ファイアウォール",
          "options": [ { "value": "on", "label": "有効（既定）" }, { "value": "partial", "label": "有効：一部許可設定（規則は手動）" }, { "value": "off", "label": "無効" } ] },
        { "id": "fw_private", "type": "choice", "label": "プライベートプロファイル", "default": "on", "target": "firewall_config", "kind": "module", "subgroup": "ファイアウォール",
          "options": [ { "value": "on", "label": "有効（既定）" }, { "value": "partial", "label": "有効：一部許可設定（規則は手動）" }, { "value": "off", "label": "無効" } ] },
        { "id": "fw_public", "type": "choice", "label": "パブリックプロファイル", "default": "on", "target": "firewall_config", "kind": "module", "subgroup": "ファイアウォール",
          "options": [ { "value": "on", "label": "有効（既定）" }, { "value": "partial", "label": "有効：一部許可設定（規則は手動）" }, { "value": "off", "label": "無効" } ] },
        { "id": "defender", "type": "choice", "label": "Windows Defender", "default": "1", "target": "辞書 2 件（改ざん防止に注意）", "kind": "dict", "subgroup": "Windows Defender・UAC",
          "options": [ { "value": "1", "label": "有効（既定）" }, { "value": "0", "label": "無効：ローカルグループポリシーにて設定", "registry": [ { "id": "00000007" }, { "id": "000000ff" } ] } ] },
        { "id": "uac", "type": "choice", "label": "ユーザーアカウント制御（UAC）", "default": "5", "target": "辞書 2 件", "kind": "dict", "subgroup": "Windows Defender・UAC",
          "options": [
            { "value": "2", "label": "常に通知する", "registry": [ { "id": "00000002", "value": "2" }, { "id": "00000003", "value": "1" } ] },
            { "value": "5", "label": "プログラム変更時のみ通知する（既定）" },
            { "value": "5n", "label": "プログラム変更時のみ通知する（デスクトップを暗転しない）", "registry": [ { "id": "00000002", "value": "5" }, { "id": "00000003", "value": "0" } ] },
            { "value": "0", "label": "通知しない", "registry": [ { "id": "00000002", "value": "0" }, { "id": "00000003", "value": "0" } ] }
          ] },
        { "id": "wu_mode", "type": "choice", "label": "適用方法", "default": "1", "target": "辞書 WindowsUpdate\\AU", "kind": "dict", "subgroup": "Windows Update",
          "options": [
            { "value": "1", "label": "自動ダウンロード、自動インストール（既定）" },
            { "value": "2", "label": "ダウンロードとインストールを通知", "registry": [ { "id": "000000f7", "value": "2" } ] },
            { "value": "3", "label": "自動ダウンロードしインストールを通知", "registry": [ { "id": "000000f7", "value": "3" } ] },
            { "value": "4", "label": "自動ダウンロードし、インストール日時を指定（毎日）", "registry": [ { "id": "000000f7", "value": "4" }, { "id": "000000f8", "value": "0" } ] },
            { "value": "5", "label": "Windows Update 無効", "registry": [ { "id": "000000f6", "value": "1" } ] }
          ] },
        { "id": "wu_install_time", "type": "number", "label": "インストール時刻", "default": "12", "unit": "時（0〜23）", "visibleWhen": { "item": "wu_mode", "values": ["4"] }, "subgroup": "Windows Update" },
        { "id": "wu_active_enabled", "type": "bool", "label": "アクティブ時間を固定する", "default": "0", "target": "辞書 SetActiveHours 他", "kind": "dict", "subgroup": "Windows Update" },
        { "id": "wu_active_start", "type": "number", "label": "アクティブ時間 開始", "default": "8", "unit": "時", "visibleWhen": { "item": "wu_active_enabled", "values": ["1"] }, "subgroup": "Windows Update" },
        { "id": "wu_active_end", "type": "number", "label": "アクティブ時間 終了", "default": "17", "unit": "時（18 時間以内）", "visibleWhen": { "item": "wu_active_enabled", "values": ["1"] }, "subgroup": "Windows Update" },
        { "id": "wu_mu", "type": "choice", "label": "その他の Microsoft 製品の更新プログラムを受け取る", "default": "0", "target": "辞書 AllowMUUpdateService", "kind": "dict", "subgroup": "Windows Update",
          "options": [ { "value": "0", "label": "無効（既定）" }, { "value": "1", "label": "有効", "registry": [ { "id": "000000fa", "value": "1" } ] } ] },
        { "id": "wu_do", "type": "choice", "label": "配信の最適化 > 他のデバイスからダウンロードを許可する", "default": "1", "target": "辞書 DODownloadMode", "kind": "dict", "subgroup": "Windows Update",
          "options": [
            { "value": "1", "label": "有効：ローカルネットワーク上のデバイス（既定）" },
            { "value": "3", "label": "有効：インターネット上のデバイスとローカルネットワーク", "registry": [ { "id": "000000a3", "value": "3" } ] },
            { "value": "0", "label": "無効（Microsoft からダウンロード）", "registry": [ { "id": "000000a3", "value": "0" } ] }
          ] },
        { "id": "power_apply", "type": "bool", "label": "電源オプションを適用する", "default": "1", "target": "power_config", "kind": "module", "subgroup": "電源オプション" },
        { "id": "power_plan", "type": "choice", "label": "電源プラン", "default": "BALANCED", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション",
          "options": [ { "value": "BALANCED", "label": "バランス（既定）" }, { "value": "POWER_SAVER", "label": "省電力" }, { "value": "HIGH_PERFORMANCE", "label": "高パフォーマンス" } ] },
        { "id": "pw_display_ac", "type": "number", "label": "ディスプレイの電源を切る（電源接続時）", "default": "5", "unit": "分（0 = 適用しない、空 = 変更しない）", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション" },
        { "id": "pw_display_dc", "type": "number", "label": "ディスプレイの電源を切る（バッテリ時）", "default": "5", "unit": "分", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション" },
        { "id": "pw_sleep_ac", "type": "number", "label": "コンピューターをスリープ状態にする（電源接続時）", "default": "15", "unit": "分", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション" },
        { "id": "pw_sleep_dc", "type": "number", "label": "コンピューターをスリープ状態にする（バッテリ時）", "default": "15", "unit": "分", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション" },
        { "id": "pw_hdd_ac", "type": "number", "label": "ハードディスクの電源を切る（電源接続時）", "default": "30", "unit": "分", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション" },
        { "id": "pw_hdd_dc", "type": "number", "label": "ハードディスクの電源を切る（バッテリ時）", "default": "15", "unit": "分", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション" },
        { "id": "pw_button", "type": "choice", "label": "電源ボタンを押したときの動作", "default": "SLEEP", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション",
          "options": [ { "value": "NOTHING", "label": "何もしない" }, { "value": "SLEEP", "label": "スリープ状態（既定）" }, { "value": "HIBERNATE", "label": "休止状態" }, { "value": "SHUTDOWN", "label": "シャットダウン" } ] },
        { "id": "pw_sleep_button", "type": "choice", "label": "スリープボタンを押したときの動作", "default": "SLEEP", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション",
          "options": [ { "value": "NOTHING", "label": "何もしない" }, { "value": "SLEEP", "label": "スリープ状態（既定）" }, { "value": "HIBERNATE", "label": "休止状態" }, { "value": "SHUTDOWN", "label": "シャットダウン" } ] },
        { "id": "pw_lid", "type": "choice", "label": "カバーを閉じたときの動作（ノート PC）", "default": "SLEEP", "visibleWhen": { "item": "power_apply", "values": ["1"] }, "subgroup": "電源オプション",
          "options": [ { "value": "NOTHING", "label": "何もしない" }, { "value": "SLEEP", "label": "スリープ状態（既定）" }, { "value": "HIBERNATE", "label": "休止状態" }, { "value": "SHUTDOWN", "label": "シャットダウン" } ] },
        { "id": "fast_startup", "type": "choice", "label": "高速スタートアップ", "default": "1", "target": "辞書 HiberbootEnabled", "kind": "dict", "subgroup": "電源オプション",
          "options": [ { "value": "1", "label": "有効（既定）" }, { "value": "0", "label": "無効", "registry": [ { "id": "00000012" } ] } ] },
        { "id": "ss_enabled", "type": "choice", "label": "スクリーンセーバー", "default": "0", "target": "辞書 3 件（HKCU → Default にも反映）", "kind": "dict", "subgroup": "スクリーンセーバー",
          "options": [ { "value": "0", "label": "無効（既定）" }, { "value": "1", "label": "有効" } ] },
        { "id": "ss_wait_min", "type": "number", "label": "待ち時間", "default": "10", "unit": "分", "visibleWhen": { "item": "ss_enabled", "values": ["1"] }, "subgroup": "スクリーンセーバー" },
        { "id": "ss_secure", "type": "bool", "label": "再開時にログオン画面に戻る", "default": "0", "visibleWhen": { "item": "ss_enabled", "values": ["1"] }, "subgroup": "スクリーンセーバー" },
        { "id": "volume_apply", "type": "bool", "label": "スピーカー音量（納品時 PC 音量）を設定する", "default": "0", "target": "volume_config", "kind": "module", "subgroup": "画面・音量" },
        { "id": "volume", "type": "number", "label": "音量", "default": "50", "unit": "%（0 = 無効）", "visibleWhen": { "item": "volume_apply", "values": ["1"] }, "subgroup": "画面・音量" },
        { "id": "resolution", "type": "text", "label": "画面解像度", "target": "resolution_api_config", "kind": "module", "placeholder": "例: 1920x1080（空欄 = 変更しない）", "subgroup": "画面・音量" },
        { "id": "dpi", "type": "choice", "label": "画面の拡大と縮小（DPI）", "default": "", "target": "dpi_api_config + dpi_config", "kind": "module", "subgroup": "画面・音量",
          "options": [ { "value": "", "label": "変更しない" }, { "value": "100", "label": "100%" }, { "value": "125", "label": "125%" }, { "value": "150", "label": "150%" }, { "value": "175", "label": "175%" } ] },
        { "id": "legacy_printer", "type": "choice", "label": "Windows で通常使うプリンターを管理する", "default": "0", "target": "辞書 LegacyDefaultPrinterMode", "kind": "dict", "subgroup": "プリンター",
          "options": [ { "value": "0", "label": "有効（既定）" }, { "value": "1", "label": "無効（推奨）", "registry": [ { "id": "000000cf", "value": "1" } ] } ] },
        { "id": "proxy_pac", "type": "text", "label": "自動構成スクリプト（PAC）の URL", "target": "辞書 AutoConfigURL", "kind": "dict", "placeholder": "例: http://proxy.example.local/proxy.pac（空欄 = 設定しない）", "subgroup": "プロキシサーバー" },
        { "id": "proxy_enabled", "type": "bool", "label": "LAN にプロキシサーバーを使用する", "default": "0", "target": "辞書 3 件", "kind": "dict", "subgroup": "プロキシサーバー" },
        { "id": "proxy_server", "type": "text", "label": "アドレス", "visibleWhen": { "item": "proxy_enabled", "values": ["1"] }, "placeholder": "例: proxy.example.local", "subgroup": "プロキシサーバー" },
        { "id": "proxy_port", "type": "text", "label": "ポート", "visibleWhen": { "item": "proxy_enabled", "values": ["1"] }, "placeholder": "例: 8080", "subgroup": "プロキシサーバー" },
        { "id": "proxy_bypass_local", "type": "bool", "label": "ローカルアドレスにはプロキシサーバーを使用しない", "default": "1", "visibleWhen": { "item": "proxy_enabled", "values": ["1"] }, "subgroup": "プロキシサーバー" },
        { "id": "proxy_exceptions", "type": "text", "label": "例外（; 区切り）", "visibleWhen": { "item": "proxy_enabled", "values": ["1"] }, "placeholder": "例: *.example.local;192.168.*", "subgroup": "プロキシサーバー" },
        { "id": "priv_location", "type": "choice", "label": "位置情報", "default": "1", "target": "辞書 2 件", "kind": "dict", "subgroup": "プライバシー",
